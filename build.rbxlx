      <Item class="ModuleScript" referent="2327">
        <Properties>
          <string name="Name">GrowTileService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Knit = require(ReplicatedStorage.Packages.Knit)
local Tiles = require(ReplicatedStorage.Modules.Tiles)
local Promise = require(ReplicatedStorage.Packages.Promise)

local GrowTileService = Knit.CreateService({
	Name = "GrowTileService",
	Client = {},
})

function GrowTileService:KnitInit() end

function GrowTileService:_GetPosition(tile)
	return tile:GetPrimaryPartCFrame().Position
end

function GrowTileService:KnitStart()
	Knit.GetService("TileService").__index = Knit.GetService("TileService")
	setmetatable(GrowTileService, Knit.GetService("TileService"))
	self.TweenService = Knit.GetService("TweenService")
end

function GrowTileService:Add(name, workspace, position, beforeParent)
	local tile = ReplicatedStorage.Placeables.GrowTile[name]:Clone()

	assert(typeof(position) == "CFrame", "Position needs to be a CFrame")

	tile:SetPrimaryPartCFrame(position)

	if beforeParent then
		beforeParent(tile)
	end

	tile.Parent = workspace
	return tile
end

function GrowTileService:GrowTile(player, base)
	local tileinfo = Tiles.Main[base.Name]

	if not self:_CheckPermissions(player, base.Parent) then
		return false
	end

	if not tileinfo or not tileinfo.grow then
		return false
	end

	base.Name = "Destroying"

	local tile = self:Add(tileinfo.grow, base.Parent, CFrame.new(base.Position), function(tile) end)

	local interruptedTween = tile.Destroying:Connect(function()
		if base then
			base:Destroy()
		end
	end)

	local duration = 2

	task.delay(duration, function()
		for _, v in pairs(tile:GetDescendants()) do
			if v:IsA("BasePart") then
				v.Transparency = 0
			end
		end
		interruptedTween:Disconnect()
		base:Destroy()
	end)

	return tile, duration
end

function GrowTileService.Client:GrowTile(...)
	return self.Server:GrowTile(...)
end

function GrowTileService.Client:DeleteTile(...)
	return self.Server:DeleteTile(...)
end

return GrowTileService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2328">
        <Properties>
          <string name="Name">RaiseTileService</string>
          <string name="Source"><![CDATA[local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Knit = require(ReplicatedStorage.Packages.Knit)
local Tiles = require(ReplicatedStorage.Modules.Tiles)

local RaiseTileService = Knit.CreateService({
	Name = "RaiseTileService",
	Client = {},
})

function RaiseTileService:KnitInit() end

function RaiseTileService:_GetPosition(tile)
	if tile:IsA("Model") then
		return tile:GetPrimaryPartCFrame().Position
	end

	return tile.Position
end

function RaiseTileService:KnitStart()
	setmetatable(RaiseTileService, Knit.GetService("TileService"))
end

function RaiseTileService:Add(name, workspace, position, beforeParent)
	local tile = ReplicatedStorage.Placeables.RaiseTile[name]:Clone()

	assert(typeof(position) == "CFrame", "Position needs to be a CFrame")

	tile:SetPrimaryPartCFrame(position)

	if beforeParent then
		beforeParent(tile)
	end

	tile.Parent = workspace
	return tile
end

function RaiseTileService:RaiseTile(player, base)
	local tileinfo = Tiles.Main[base.Name]

	if not self:_CheckPermissions(player, base.Parent) then
		warn("You don't have permission for this tile")
		return false
	end

	if not tileinfo or not tileinfo.raise then
		return false
	end

	base.Name = "Destroying"

	local tile = self:Add(tileinfo.raise, base.Parent, CFrame.new(self:_GetPosition(base)))

	-- If the tween is interrupted the base should be destroyed.
	-- if the tween finishes this event is disconnected.
	local interruptedTween = tile.Destroying:Connect(function()
		if base then
			base:Destroy()
		end
	end)

	local duration = 2

    local name = tile.Name
    tile.Name = "Rising"

	task.delay(duration, function()
		interruptedTween:Disconnect()
		base:Destroy()
        tile.Name = name
	end)

	return tile, base, duration
end

function RaiseTileService.Client:RaiseTile(...)
	return self.Server:RaiseTile(...)
end

function RaiseTileService.Client:DeleteTile(...)
	return self.Server:DeleteTile(...)
end

return RaiseTileService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2329">
        <Properties>
          <string name="Name">SaveService</string>
          <string name="Source"><![CDATA[local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local DataStore = game:GetService("DataStoreService")
local SaveDataStore = DataStore:GetDataStore("SaveData")

local Knit = require(ReplicatedStorage.Packages.Knit)
local Signal = require(ReplicatedStorage.Packages.Signal)
local Promise = require(ReplicatedStorage.Packages.Promise)

local Set = require(ReplicatedStorage.Util.tableUtil).Set

local SaveService = Knit.CreateService({
	Name = "SaveService",
	TilesAdded = Signal.new(),
	Client = {},
	IdTable = {
		"Grass", -- 1
		"Sand",
		"Desert",
		"Snow",
		"Stone", --5
		"Fertile Land",
		"CactusDesert",
		"DesertRuins",
		"DesertRuinsClaimed",
		"Farm", -- 10
		"FarmClaimed",
		"Forest",
		"ForestClaimed",
		"Mountain",
		"MountainClaimed", -- 15
		"PalmSand",
		"PalmSandClaimed",
		"SettlementLV1",
		"SettlementLV2",
		"SettlementLV3", -- 20
		"SnowForest",
		"SnowForestClaimed",
		"SnowMountain",
		"SnowMountainClaimed",
		"Volcano",
		"VolcanoClaimed",
		"SettlementLV4",
		"SettlementLV5", -- 28
	},
	SlotTable = {},
	Timer = 0
})

function SaveService:_Serialize(property)
	local pType = typeof(property)
	local sData

	if pType == "Vector3" then
		sData = { x = property.x, y = property.y, z = property.z }
	elseif pType == "CFrame" then
		sData = {
			position = self._Serialize(property.Position),
			rX = self._Serialize(property.RightVector),
			rY = self._Serialize(property.UpVector),
			rZ = self._Serialize(-property.LookVector),
		}
	elseif pType == "BrickColor" then
		sData = tostring(property)
	elseif pType == "Color3" then
		sData = { Color3.ToHSV(property) }
	else
		error("Unrecognised Data Type")
	end

	return sData
end

function SaveService:_Deserialize(property, pType)
	local dData -- Deserialized data

	if pType == "Vector3" then
		dData = Vector3.new(property.x, property.y, property.z)
	elseif pType == "CFrame" then
		dData = CFrame.fromMatrix(
			self._Deserialize(property.position, "Vector3"),
			self._Deserialize(property.rX, "Vector3"),
			self._Deserialize(property.rY, "Vector3"),
			self._Deserialize(property.rZ, "Vector3")
		)
	elseif pType == "BrickColor" then
		dData = BrickColor.new(property)
	elseif pType == "Color" then
		dData = Color3.fromHSV(unpack(property))
	end

	return dData
end

function SaveService:_SerializeWorkspace(pWorkspace: Model)
	local saveData = { {
		Id = "Meta",
		Place = 1,
		Chunks = 1,
		Length = 0,
	}, {} }

	local children = pWorkspace:GetChildren()
	local wCFrame = pWorkspace:GetPrimaryPartCFrame()
	local metaData = saveData[1]
	local currentChunk = saveData[2]

	for i = 1, #children do
		local v = children[i]
		local id = self.invIdTable[v.Name]

		if not id then
			continue
		end

		if not v:GetAttribute("interactable") then
			continue
		end

		local itemData = {}

		itemData["Id"] = id

		if v:IsA("Part") then
			itemData["Position"] = self:_Serialize(v.Position - wCFrame.Position)
			itemData["Size"] = self:_Serialize(v.Size)
			itemData["Orientation"] = self:_Serialize(v.Orientation)
		elseif v:IsA("Model") then
			itemData["CFrame"] = self:_Serialize(v:GetPrimaryPartCFrame():ToObjectSpace(wCFrame))
		end

		itemData["Attributes"] = v:GetAttributes()

		local length = HttpService:JSONEncode(itemData):len()

		if metaData.Length + length > 3950000 then -- Safety buffer
			metaData.Chunks += 1
			metaData.Length = 0
			saveData[metaData.Chunks + 1] = {}
			currentChunk = saveData[metaData.Chunks + 1]
		end

		metaData.Length += length

		currentChunk[#currentChunk + 1] = itemData
	end
	return saveData
end

function SaveService:_DeserializeWorkspace(data: table, pWorkspace: Model)
	local metaData = data[1]
	local wCFrame = pWorkspace:GetPrimaryPartCFrame()

	if not (metaData.Id and metaData.Id == "Meta") then
		warn("Save file isn't valid, perhaps legacy.")
		return
	end

	for i = 2, metaData.Chunks + 1 do
		local chunk = data[i]

		for j = 1, #chunk do
			local itemData = chunk[j]
			local objectName = self.IdTable[itemData.Id]
			local objectParent = self.tileLocations[objectName]

			local tile = ReplicatedStorage.Placeables[objectParent.Name][objectName]:Clone()
			if tile:IsA("Model") then
				tile:SetPrimaryPartCFrame(self:_Deserialize(itemData.CFrame, "CFrame"):ToWorldSpace(wCFrame))
			elseif tile:IsA("Part") then
				tile.Position = self:_Deserialize(itemData.Position, "Vector3") + wCFrame.Position
				tile.Size = self:_Deserialize(itemData.Size, "Vector3")
				tile.Orientation = self:_Deserialize(itemData.Orientation, "Vector3")
			end

			for k, v in pairs(itemData.Attributes) do
				tile:SetAttribute(k, v)
			end

			tile.Parent = pWorkspace
		end
	end

	self.TilesAdded:Fire(pWorkspace)
end

function SaveService.Client:LoadWorkspace(player, slot)
	return self.Server:LoadWorkspace(player, slot)
end

function SaveService:SaveWorkspace(player, slot)

	local pWorkspace = Knit.GetService("WorkspaceService"):getPlayerWorkspace(player)
	local data = self:_SerializeWorkspace(pWorkspace)

	local metadata = data[1]
	local chunk = data[2]

	local success = pcall(function()
		return SaveDataStore:SetAsync("p" .. player.UserId .. "s" .. slot, data)
	end)

	if metadata.Chunks > 1 then
		for i=2, metadata.Chunks do
			local s = pcall(function()
				return SaveDataStore:SetAsync("p".. player.UserId .. "s" .. slot .. "c" .. i, data[i+1])
			end)
			if not s then
				error("Chunks failed to save properly")
			end
		end
	end

	if not success then
		return false
	end

	return true
end

function SaveService:LoadWorkspace(player: Player, slot)
	local success, result = pcall(function()
		return SaveDataStore:GetAsync("p" .. player.UserId .. "s" .. slot)
	end)

	if not success then -- Game couldn't load
		return false
	end

	if not result then -- Save was empty
		return true
	end

	local chunks = result[1].Chunks

	if chunks > 1 then
		local toAdd = {}
		for i=2, chunks do
			local s, r = pcall(function()
				return SaveDataStore:GetAsync("p" .. player.UserId .. "s" .. slot .. "c" .. i)
			end)

			if not s then
				error("Couldn't find chunks")
			end

			toAdd[#toAdd+1] = r
		end
		for i=1, #toAdd do
			result[#result+1] = toAdd[i]
		end
	end

	local pWorkspace = Knit.GetService("WorkspaceService"):getPlayerWorkspace(player)

	self.SlotTable[player.UserId] = slot

	self:_DeserializeWorkspace(result, pWorkspace)

	return success
end

function SaveService:Stepped(dt)
	local timeInterval = 120
	self.Timer += dt

	if self.Timer >= timeInterval then

		for _, player in pairs(Knit.GetService("WorkspaceService"):getPlayersOnWorkspaces()) do
			local slot = self.SlotTable[player.UserId]
			if slot then
				SaveService:SaveWorkspace(player, slot)
			end
		end

		self.Timer -= timeInterval
	end
end

-- function SaveService:KnitInit()
-- 	self.invIdTable = {}
-- 	self.tileLocations = {}
-- 	self.services = {}

-- 	for i, v in ipairs(self.IdTable) do
-- 		self.invIdTable[v] = i
-- 	end

-- 	local idset = Set(self.IdTable)

-- 	for _, v in pairs(ReplicatedStorage.Placeables:GetDescendants()) do
-- 		if v.Name and idset[v.Name] then
-- 			self.tileLocations[v.Name] = v.Parent
-- 			self.services[v.Parent.Name] = {}
-- 		end
-- 	end
-- end

-- function SaveService:KnitStart()
-- 	for i, _ in pairs(self.services) do
-- 		self.services[i] = Knit.GetService(i .. "Service")
-- 	end
-- end

return SaveService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2330">
        <Properties>
          <string name="Name">SettlementService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Knit = require(ReplicatedStorage.Packages.Knit)
local Tiles = require(ReplicatedStorage.Modules.Tiles)
local Component = require(ReplicatedStorage.Packages.Component)

local tableremove = require(ReplicatedStorage.Util.tableUtil).arrayRemove

local SettlementService = Knit.CreateService({
	Name = "SettlementService",
	Settlements = {},
	Client = {
		AddWorkerButton = Knit.CreateSignal(),
		AddSettlementBillboard = Knit.CreateSignal()
	},
})

local Settlement = {}
Settlement.__index = Settlement

function SettlementService:KnitInit() end

function SettlementService:LevelToXP(level)
	return level * 80
end

function SettlementService:KnitStart()
	self.WorkspaceService = Knit.GetService("WorkspaceService")
	self.FactionService = Knit.GetService("FactionService")
	setmetatable(self, Knit.GetService("TileService"))
end

function SettlementService:ValidateNames(player, sText, fText)
	local sTextObject, fTextObject
	do
		local sucess, errorMsg = pcall(function()
			sTextObject = TextService:FilterStringAsync(sText, player.UserId)
			fTextObject = TextService:FilterStringAsync(fText, player.UserId)
		end)

		if not sucess then
			warn(errorMsg)
			return false
		end
	end

	local sFiltered, fFiltered
	do
		local sucess, errorMsg = pcall(function()
			sFiltered = sTextObject:GetNonChatStringForBroadcastAsync()
			fFiltered = fTextObject:GetNonChatStringForBroadcastAsync()
		end)

		if not sucess or sFiltered:find("#") or fFiltered:find("#") then
			warn(errorMsg or "Text contains unsuitable words")
			return false
		end
	end

	return { name = sFiltered, faction = fFiltered }
end

function SettlementService:CreateBillboard(parent: Model)
	local player = Players:GetPlayerByUserId(self.WorkspaceService:GetWorkspacePlayer(parent.Parent))
	local factionColor = self.FactionService:GetFaction(player, assert(parent:GetAttribute("faction")))[1]
	self.Client.AddSettlementBillboard:FireAll(parent, factionColor)
end

function SettlementService:Exists(name)
	if self.Settlements[name] then
		return true
	end

	return false
end

function SettlementService:Add(position, workspace, basetile, level, attributes)
	local s = {}
	setmetatable(s, Settlement)

	if not basetile or not Tiles.checkSettle(basetile.Name) then
		error("Could not create settlement, base tile doesn't exist.")
	end

	if self.Settlements[attributes.name] then
		error("Already a settlement exists with this name.")
	end

	local tileName = "SettlementLV" .. level

	s.tile = ReplicatedStorage.Placeables.Settlement[tileName]:Clone()
	s.tile:PivotTo(position)

	for k, v in pairs(attributes) do
		s.tile:SetAttribute(k, v)
	end

	if basetile.SelectionBox.Visible then
		basetile.SelectionBox.Visible = false
	end

	s.tile.SelectionBox.Adornee = s.tile
	basetile.Parent = s.tile

	self.Settlements[s.tile:GetAttribute("name")] = s
	s.tile.Parent = workspace
	self:CreateBillboard(s.tile)
end

function SettlementService:PlaceSettlement(player, position, workspace, basetile, name, faction)
	if not self.WorkspaceService:CheckPermissions(player, workspace) then
		warn("You don't have permission for this!")
		return false
	end

	self:Add(position, workspace, basetile, 1, { name = name, faction = faction })
end

function SettlementService:DeleteTile(player, tile)
	if not self:_CheckPermissions(player, tile.Parent) then
		warn("You don't have permission to delete")
		return false
	end

	if not Tiles.Main[tile.Name] then
		warn("You can't delete this")
	end

	local name = tile:GetAttribute("name")
	self.Settlements[name] = nil

	self:_CreateExplosion(tile:GetPivot().Position)

	tile:Destroy()

	return true
end

function SettlementService.Client:DeleteTile(...)
	return self.Server:DeleteTile(...)
end

function SettlementService.Client:ValidateNames(...)
	return self.Server:ValidateNames(...)
end

function SettlementService.Client:Exists(...)
	return self.Server:Exists(...)
end

function SettlementService.Client:PlaceSettlement(...)
	return self.Server:PlaceSettlement(...)
end

return SettlementService
]]></string>
