      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">InputController</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Knit = require(ReplicatedStorage.Packages.Knit)
local Signal = require(ReplicatedStorage.Packages.Signal)
local Tiles = require(ReplicatedStorage.Modules.Tiles)

local InputController = Knit.CreateController({
	Name = "InputController",
	_RaycastParams = RaycastParams.new(),
	_Mouse = Players.LocalPlayer:GetMouse(),
	_PlacePosition = Vector3.new(0, 0, 0),
	_SelectionBox = nil,
})

function InputController:_GetValidTile(target)
	if self.selectionBox then
		self.selectionBox.Visible = false
		self.selectionBox = nil
	end

	if not target then
		return nil
	end

	if target:FindFirstChild("SelectionBox") and target.Parent.Parent == workspace and Tiles.Main[target.Name] then
		self.selectionBox = target:FindFirstChild("SelectionBox")
		self.selectionBox.Visible = true
		return target
	end

	local model = target:FindFirstAncestorWhichIsA("Model")

	if not model or model.Parent == workspace then
		return false
	end

	if model:FindFirstChild("SelectionBox") and Tiles.Main[model.Name] then
		self.selectionBox = model:FindFirstChild("SelectionBox")
		self.selectionBox.Visible = true
		return model
	end

	return self:_GetValidTile(model)
end

function InputController:_GetMouseTarget()
	return self._Mouse.Target
end

function InputController:onInput(inputObject: InputObject, gameProcessedEvent)
	if gameProcessedEvent then
		return
	end

	if inputObject.UserInputType == Enum.UserInputType.Keyboard then
		local key = inputObject.KeyCode

		if key == Enum.KeyCode.V then
			if self._Target then
				self[Tiles.Main[self._Target.Name].service]:DeleteTile(self._Target)
			end
		end

		if key == Enum.KeyCode.C then
			self.SelectionController:CancelSelection()
		end

		if key == Enum.KeyCode.Q then
			self.SelectionController:SetPreviousSelection()
		end

		if key == Enum.KeyCode.X then
			if self._Target and Tiles.Main[self._Target.Name].grow then
				self.GrowTileService:GrowTile(self._Target):andThen(function(tile, duration)
					if tile and duration then
						self.TweenController:GrowTile(tile, duration)
					end
				end)
			end
		end

		if key == Enum.KeyCode.R then
			if self._Target and Tiles.Main[self._Target.Name].raise then
				self.RaiseTileService:RaiseTile(self._Target):andThen(function(...)
					self.TweenController:RaiseTile(...)
				end)
			end
		end
	end

	if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
		self.SelectionController:TriggerSelection()
	end
end

function InputController:onInputHeld(input)
	local character = Players.LocalPlayer.Character:FindFirstChild("Humanoid")

	if input.KeyCode == Enum.KeyCode.LeftShift then
		if character then
			character.JumpPower = 200
			character.WalkSpeed = 150
		end
	end
end

function InputController:onInputStopHeld(input)
	local character = Players.LocalPlayer.Character:FindFirstChild("Humanoid")

	if input.KeyCode == Enum.KeyCode.LeftShift then
		if character then
			character.JumpPower = 50
			character.WalkSpeed = 16
		end
	end
end

function InputController:KnitInit()
	local result, pWorkspace = Knit.GetService("WorkspaceService"):getPlayerWorkspace():await()
	if not result then
		error("Critical input failure beep boop :(")
	end
	self.workspace = pWorkspace

	self._RaycastParams.FilterDescendantsInstances = { pWorkspace.Baseplate }
	self._RaycastParams.FilterType = Enum.RaycastFilterType.Whitelist

	UserInputService.InputEnded:Connect(function(...)
		self:onInput(...)
	end)

	UserInputService.InputBegan:Connect(function(...)
		self:onInputHeld(...)
	end)

	UserInputService.InputEnded:Connect(function(...)
		self:onInputStopHeld(...)
	end)

	self._Mouse.TargetFilter = workspace.LightController
end

function InputController:GetValidTarget()
	return self._Target
end

function InputController:AddedWorkerButton()

end

function InputController:KnitStart()
	self.SelectionController = Knit.GetController("SelectionController")
	self.TweenController = Knit.GetController("TweenController")

	self.TileService = Knit.GetService("TileService")
	self.GrowTileService = Knit.GetService("GrowTileService")
	self.RaiseTileService = Knit.GetService("RaiseTileService")
	self.SettlementService = Knit.GetService("SettlementService")

end

function InputController:Stepped()
	local ray = workspace:Raycast(self._Mouse.UnitRay.Origin, self._Mouse.UnitRay.Direction * 1000, self._RaycastParams)
	if ray then
		self._PlacePosition = ray.Position
	end

	local mousetarget = self._Mouse.Target

	self._Target = self:_GetValidTile(mousetarget)
end

function InputController:GetCustomRaycastTarget(pWorkspace: Model)
	return self._PlacePosition
end

return InputController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">LightController</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

local Knit = require(ReplicatedStorage.Packages.Knit)

local LightController = Knit.CreateController({
	Name = "LightController",
})

function LightController:KnitInit()
	self._light = Instance.new("Part")

	self._light.Name = "LightController"
	self._light.Anchored = true
	self._light.Transparency = 1
	self._light.Size = Vector3.new(4, 1, 2)
	self._light.CanCollide = false

	self._pointLight = Instance.new("PointLight")
	self._pointLight.Brightness = 0.72
	self._pointLight.Range = 24
	self._pointLight.Parent = self._light

	self._light.Parent = workspace
end

function LightController:Stepped()
	mouse.TargetFilter = self._light
	self._light.Position = mouse.Hit.Position + Vector3.new(0, 10, 0)
end

return LightController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">MenuScreenController</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Knit = require(ReplicatedStorage.Packages.Knit)

local MenuScreenController = Knit.CreateController({
	Name = "MenuScreenController",
	_Loading = false,
})

function MenuScreenController:_OnLoadClick(button: TextButton, slot: number)
	local SaveService = Knit.GetService("SaveService")

	return function()
		if self._Loading then
			return
		end

		self._Loading = true

		SaveService:LoadWorkspace(slot)
			:andThen(function(success)
				if not success then
					button.BackgroundColor3 = Color3.fromRGB(201, 43, 43)
					button.Text = "Failed to Load"
                    self._Loading = false
					return false
				end
				button.BackgroundColor3 = Color3.fromRGB(54, 163, 54)
				button.Text = "Loaded"
			end)
		button.BackgroundColor3 = Color3.fromRGB(243, 173, 42)
		button.Text = "<i>Loading...</i>"
	end
end

function MenuScreenController:_BuildMenuScreen()
	local gui = Instance.new("ScreenGui")

	local blur = Instance.new("BlurEffect")
	blur.Enabled = true
	blur.Size = 20
	blur.Parent = Lighting

	local buttonPrefab = Instance.new("TextButton")
	local corners = Instance.new("UICorner")

	corners.CornerRadius = UDim.new(1)
	corners.Parent = buttonPrefab

	buttonPrefab.BackgroundColor3 = Color3.new(1, 1, 1)
	buttonPrefab.BackgroundTransparency = 0.5
	buttonPrefab.AutomaticSize = Enum.AutomaticSize.XY

	buttonPrefab.TextSize = 45
	buttonPrefab.TextColor3 = Color3.fromRGB(48, 48, 48)
	buttonPrefab.Font = "Nunito"
	buttonPrefab.RichText = true
	buttonPrefab.AnchorPoint = Vector2.new(0.5, 0.5)

	buttonPrefab.Size = UDim2.fromScale(0.191, 0.067)

	local buttons = {}

	for i = 1, 3 do
		buttons[i] = buttonPrefab:Clone()
		buttons[i].Text = "<b>Slot " .. i .. "</b>"
		buttons[i].Position = UDim2.fromScale(0.2 + 0.3 * (i - 1), 0.8)
        buttons[i].MouseButton1Click:Connect(self:_OnLoadClick(buttons[i], i))
		buttons[i].Parent = gui
	end

	local titleImage = Instance.new("ImageLabel")

	titleImage.Image = "rbxassetid://10224966784"
	titleImage.BackgroundTransparency = 1
	titleImage.ScaleType = Enum.ScaleType.Fit
	titleImage.AnchorPoint = Vector2.new(0.5, 0.5)
	titleImage.Position = UDim2.fromScale(0.5, 0.33)
	titleImage.Size = UDim2.fromScale(0.5, 0.5)

	titleImage.Parent = gui

	return gui
end

function MenuScreenController:KnitInit() end

function MenuScreenController:KnitStart()
	-- disable for testing.
	--self:_BuildMenuScreen().Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
end

return MenuScreenController
]]></string>
