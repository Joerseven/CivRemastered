      <Item class="ModuleScript" referent="2324">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Players = game:GetService("Players")
local Knit = require(ReplicatedStorage.Packages.Knit)
local Promise = require(ReplicatedStorage.Packages.Promise)

local EventService = Knit.CreateService({
	Name = "EventService",
	_Services = {},
	_Ignore = {},
	Client = {},
})

function EventService:KnitInit()
	for _, v in pairs(ServerStorage.Services:GetChildren()) do
		if v.Name ~= "EventService" then
			self._Services[v.Name] = Knit.GetService(v.Name)
		end
	end
end

function EventService:KnitStart()
	Players.PlayerAdded:Connect(function(player)
		for _, v in pairs(self._Services) do
			if v.PlayerAdded then
				v:PlayerAdded(player)
			end
		end

		player.CharacterAdded:Connect(function(character)
			local humanoid = character:FindFirstChild("Humanoid")
			if humanoid then
				humanoid.Died:Connect(function()
					Promise.delay(1):andThen(function()
						player:LoadCharacter()
					end)
				end)
			end
		end)

		player:LoadCharacter()
	end)

	Players.PlayerRemoving:Connect(function(player)
		for _, v in pairs(self._Services) do
			if v.PlayerRemoving then
				v:PlayerRemoving(player)
			end
		end
	end)

	RunService.Stepped:Connect(function(dt)
		for _,v in pairs(self._Services) do
			if v.Stepped then
				v:Stepped(dt)
			end
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2325">
        <Properties>
          <string name="Name">FactionService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Knit = require(ReplicatedStorage.Packages.Knit)

local FactionService = Knit.CreateService({
	Name = "FactionService",
	Client = {},
	_FactionLists = {},
})

function FactionService:KnitInit()
	math.randomseed(os.time())
	math.random()
	math.random()
	math.random()
end

function FactionService:KnitStart() end

function FactionService:_CreateFaction(player, name)
	self._FactionLists[player.UserId][name] = { Color3.fromHSV(math.random(), 0.5, 0.8) }
	return self._FactionLists[player.UserId][name]
end

function FactionService:GetFaction(player, name)
	if not self._FactionLists[player.UserId] then
		self._FactionLists[player.UserId] = {}
	end

	local faction = self._FactionLists[player.UserId][name]

	if not faction then
		return self:_CreateFaction(player, name)
	end

	return faction
end

return FactionService
]]></string>
        </Properties>
