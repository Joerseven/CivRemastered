      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">DayCycleController</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")

local Knit = require(ReplicatedStorage.Packages.Knit)

local TIMEMULT = 50

local DayCycleController = Knit.CreateController({
	Name = "DayCycleController",
	_TimeInSeconds = 22000,
})

function DayCycleController:_BuildTimeString(seconds: number)
	local hours = string.format("%d", math.floor(seconds / 3600))
	local mins = string.format("%d", math.floor(seconds / 60 - (hours * 60)))
	local seconds = string.format("%d", math.floor(seconds - hours * 3600 - mins * 60))

	return hours .. ":" .. mins .. ":" .. seconds
end

function DayCycleController:KnitInit() end

function DayCycleController:Stepped(delta)
    self._TimeInSeconds =  self._TimeInSeconds + delta * TIMEMULT
    Lighting.TimeOfDay = self:_BuildTimeString(self._TimeInSeconds)
end

return DayCycleController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">EventController</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Knit = require(ReplicatedStorage.Packages.Knit)
local TableUtil = require(ReplicatedStorage.Packages.TableUtil)

local EventController = Knit.CreateController({
	Name = "EventController",
	_Controllers = {},
	_Ignore = {
		Stepped = {
			"InputController",
		},
	},
})

function EventController:KnitInit()
	for _, v in pairs(ReplicatedStorage.Controllers:GetChildren()) do
		if v.Name ~= "EventController" then
			self._Controllers[v.Name] = Knit.GetController(v.Name)
		end
	end
end

function EventController:KnitStart()
	local steppedControllers = TableUtil.Copy(self._Controllers)

	for _, v in pairs(self._Ignore.Stepped) do
		steppedControllers[v] = nil
	end

	RunService.Stepped:Connect(function(_, dt)
		self._Controllers.InputController:Stepped(dt)

		for _, v in pairs(steppedControllers) do
			local stepped = v.Stepped
			if stepped then
				v:Stepped(dt)
			end
		end
	end)
end

return EventController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">GUIController</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local TextService = game:GetService("TextService")
local player = game.Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Knit = require(ReplicatedStorage.Packages.Knit)
local Component = require(ReplicatedStorage.Packages.Component)
local TableUtil = require(ReplicatedStorage.Packages.TableUtil)
local Promise = require(ReplicatedStorage.Packages.Promise)

local GUIController = Knit.CreateController({
	Name = "GUIController",
	buttons = {},
	frames = {},
})

function GUIController:LevelToXP(level)
	return level * 80
end

function GUIController:SwitchSelectedAction(name)
	name = name or ""

	if self.actionBar.Active and not TableUtil.IsEmpty(self.actionBar.Active) then
		self.actionBar.Active[2]:Finish()
		self.actionBar.Active[1]:TransparentBackground():RoundedSquare(0)

		local pName = self.actionBar.Active[1].i.Name

		self.actionBar.Active = {}

		if pName == name then
			self.SelectionController:CancelSelection()
			return
		end
	end

	for _, v in pairs(self.frames) do
		if v.i.Name == name then
			v:BackgroundColor(Color3.fromRGB(60, 179, 113)):TransparentBackground(true)

			self.actionBar.Active = {
				v,
				self.TweenController:NewTween({
					duration = 0.5,
					object = v.i,
					property = "Size",
					target = UDim2.fromOffset(90, 90),
				}),
			}

			if name == "Settlement" then
				self.SelectionController:SettleSelection()
				return true
			end

			self.SelectionController:TileSelection(name)
			return true
		end
	end
end

function GUIController:CreateSettlementPrompt(parent)
	if not parent then
		parent = self.ScreenGui
	end

	local frame = Component
		:new("Frame", parent)
		:FadeBackground()
		:Center()
		:Middle()
		:Padding(15, 15, 15, 15)
		:RoundedSquare(20, 20)
		:MakeList(10, false)
		:AutoSize() -- override only one autosize
		:Position(-5, -0.2)

	local text = Component:new("TextLabel", frame)
		:Font("Nunito", 40)
		:Center()
		:AutoSize()
		:Text("Create Settlement")
		:TransparentBackground()
		:Border(0)

	local settleName = Component:new("TextBox", frame)
		:Font("Nunito", 24)
		:Center()
		:DefaultText("Settlement Name")
		:Text("")
		:BackgroundColor(Color3.new(1, 1, 1))
		:RoundedRectangle(300, 40, 20)
		:Border(0)

	local settleFaction = settleName:Clone():DefaultText("Faction Name")

	local confirmButton = Component:new("TextButton", frame)
		:Font("Nunito", 32)
		:Center()
		:Text("Confirm")
		:BackgroundColor(Color3.new(0.14, 0.14, 0.25))
		:Border(0)
		:RoundedRectangle(1, 40, 40)
		:AutoSize()
		:Padding(0, 20, 0, 20)
		:TextColor(Color3.new(1, 1, 1))

	frame:Mount()

	local p = Promise.new(function(resolve, reject, onCancel)
		if onCancel(function()
			if frame then
				frame.i:Destroy()
			end
		end) then
			return
		end

		confirmButton.i.MouseButton1Click:Connect(function()
			local sText = settleName.i.Text
			local fText = settleFaction.i.Text

			if sText == "" or fText == "" then
				text.i.Text = "Can't be empty!"
				return
			end

			if sText:len() > 30 or fText:len() > 30 then
				text.i.Text = "Settlement or faction name too long!"
				return
			end

			if sText:find("#") or fText:find("#") then
				text.i.Text = "Can't have the hash symbol!"
				return
			end

			local status, info = self.SettlementService:ValidateNames(sText, fText):await()

			if not status or not info then
				text.i.Text = "Roblox filtering didn't like that."
				return
			end

			local estatus, eresult = self.SettlementService:Exists(info.name):await()

			if not estatus or eresult then
				text.i.Text = "Settlement already exists."
				return
			end

			frame.i:Destroy()
			resolve(info)
		end)
	end)

	return p
end

function GUIController:CreateBillboard(adornee: Model, factionColor)
	-- Create the interface
	-- Create Billboard GUI
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(12, 6.4)
	billboard.SizeOffset = Vector2.new(0, 2)
	billboard.Parent = self.ScreenGui
	billboard.Adornee = adornee
	billboard.AlwaysOnTop = false
	billboard.StudsOffset = Vector3.new(0, -7.5, 0)
	billboard.Active = true

	adornee.Destroying:Connect(function()
		billboard:Destroy()
	end)

	local containerFrame =
		Component:new("Frame", billboard):TransparentBackground():RSize(0.5, 0.25):Center():Bottom():Mount()

	local clipFrame = Component:new("Frame", containerFrame):TransparentBackground():RSize(1, 0.8):Clip():Mount()

	local frame = Component:new("Frame", clipFrame):RoundedRectangle(1, 1, 9999999):RSize(1, 1.2):FadeBackground()

	frame.i.Corners.CornerRadius = UDim.new(0.2, 0)

	local barsize = adornee:GetAttribute("supplyCount") / self:LevelToXP(adornee:GetAttribute("level"))

	local name = Component:new("TextLabel", frame)
		:Position(0.23, 0.42)
		:RSize(0.7, 0.8)
		:RPadding(0.1, 0.1, 0.1, 0.1)
		:Middle()
		:TransparentBackground()
		:Font("Nunito")
		:Text(adornee:GetAttribute("name"))
		:FontColor(Color3.new(0.2, 0.2, 0.2))
		:TextScaled()

	local xpbar = Component
		:new("Frame", containerFrame)
		:Bottom()
		:RSize(barsize, 0.2)
		:BackgroundColor(Color3.fromHex("#22B95E"))
		:Border(0)
		--:Anchor(Vector2.new(0,0))
		:CurveCorners(999999)
		:BringForward(-4)
		:Mount()

	local level = Component:new("TextLabel", containerFrame)
		:RCircle(1.5)
		:Position(-0.2, 0)
		:Constrain("y")
		:Middle()
		:RPadding(0.25, 0.25, 0.25, 0.25)
		:Border(0)
		:BackgroundColor(factionColor)
		:Font("Nunito")
		:TextScaled()
		:FontColor(Color3.new(1, 1, 1))
		:Text(adornee.Name:sub(-1, -1))
		:Bold()
		:BringForward(2)
		:Mount()

	frame:Mount()

	adornee.AttributeChanged:Connect(function(attribute)
		if attribute == "supplyCount" then
			xpbar:RSize(adornee:GetAttribute("supplyCount") / self:LevelToXP(adornee:GetAttribute("level")), 0.2)
		end
	end)

	self:CreateWorkerButton(containerFrame.i)
end

function GUIController:CreateWorkerButton(parent)
	local colors = {
		work = Color3.new(1, 0.8, 0.2),
		active = Color3.fromRGB(60, 179, 113),
	}

	if parent:FindFirstChild("AddWorker") then
		warn("A button already exists")
	end

	local frame = Component:new("Frame", parent)
		:RCircle(0.9)
		:Position(1, 0)
		:Name("AddWorker")
		:Constrain()
		:BackgroundColor(colors.work)

	frame.i.AnchorPoint = Vector2.new(0.5, 0.5)

	local button = Component:new("TextButton", frame)
		:BringForward(5)
		:RCircle(1)
		:Position(0, 0)
		:Text()
		:TransparentBackground()
		:Constrain()

	local hammerImg = Component:new("ImageLabel", frame)
		:TransparentBackground()
		:Name("Hammer")
		:Constrain()
		:ImageUrl("10555583305")
		:Position(0.5, 0.5)
		:RSize(0.6, 0.6)

	hammerImg.i.AnchorPoint = Vector2.new(0.5, 0.5)
	hammerImg.i.ScaleType = Enum.ScaleType.Fit
	hammerImg.i.Rotation = 25

	frame:Mount()

	button.i.MouseButton1Click:Connect(function()
		frame:BackgroundColor(colors.active)
		self.SelectionController:WorkSelection(function() -- On Cancel Function
			frame:BackgroundColor(colors.work)
		end)
	end)
end

function GUIController:_CreateActionBar(parent)
	local images = {
		{ "Grass", "10465517589" },
		{ "Stone", "10465517392" },
		{ "Desert", "10465516847" },
		{ "Farmland", "10465516455" },
		{ "Sand", "10465517062" },
		{ "Snow", "10465517234" },
	}

	local settleImage = "10465516691"

	self.actionBar = Component:new("Frame", parent)
		:Center()
		:Bottom(-10)
		:FadeBackground()
		:CurveCorners(50)
		:MakeList(20, true)
		:Height(80)
		:Padding(0, 5, 0, 20)
		:Name("ActionBar")

	for _, v in ipairs(images) do
		local image = Component:new("ImageButton", self.actionBar)
			:ImageUrl(v[2])
			:Square(80)
			:TransparentBackground()
			:Name(v[1])
			:BringForward()

		local label = Component:new("TextLabel", image)
			:Center()
			:Top(-40)
			:AutoSize()
			:BackgroundColor(Color3.new(1, 1, 1))
			:CurveCorners(20)
			:Text(v[1])
			:Padding(10, 10, 10, 10)
			:Font("Nunito", 25)
			:BringForward(3)
			:NotVisible()

		image.i.MouseButton1Click:Connect(function()
			GUIController:SwitchSelectedAction(image.i.Name)
		end)

		image.i.MouseEnter:Connect(function()
			label:Show()
		end)

		image.i.MouseLeave:Connect(function()
			label:Hide()
		end)

		local frame = Component:new("Frame", image)
			:RoundedSquare(20, 15)
			:TransparentBackground()
			:Name(v[1])
			:Center()
			:Middle()
			:Circle(0)

		self.frames[#self.frames + 1] = frame
		self.buttons[#self.buttons + 1] = image
	end

	local divider = Component:new("Frame", self.actionBar):Circle(10):BackgroundColor(Color3.new())

	local settle = Component:new("ImageButton", self.actionBar)
		:ImageUrl(settleImage)
		:Square(80)
		:TransparentBackground()
		:Name("Settlement")
		:BringForward()

	local label = Component:new("TextLabel", settle)
		:Center()
		:Top(-40)
		:AutoSize()
		:BackgroundColor(Color3.new(1, 1, 1))
		:CurveCorners(20)
		:Text("Settlement")
		:Padding(10, 10, 10, 10)
		:Font("Nunito", 25)
		:BringForward(3)
		:NotVisible()

	settle.i.MouseButton1Click:Connect(function()
		GUIController:SwitchSelectedAction(settle.i.Name)
	end)

	settle.i.MouseEnter:Connect(function()
		label:Show()
	end)

	settle.i.MouseLeave:Connect(function()
		label:Hide()
	end)

	local frame = Component:new("Frame", settle)
		:RoundedSquare(20, 15)
		:TransparentBackground()
		:Name("Settlement")
		:Center()
		:Middle()
		:Circle(0)

	self.frames[#self.frames + 1] = frame
	self.buttons[#self.buttons + 1] = settle

	self.actionBar:Mount()
end

function GUIController:KnitInit()
	local PlayerGui = player:WaitForChild("PlayerGui")
	self.ScreenGui = Instance.new("ScreenGui")
	self.ScreenGui.Enabled = false
	self.ScreenGui.Name = "MenuGui"
	self.ScreenGui.ResetOnSpawn = false
	self.ScreenGui.Parent = PlayerGui

	self:_CreateActionBar(self.ScreenGui)
end

function GUIController:KnitStart()
	self.TweenController = Knit.GetController("TweenController")
	self.SelectionController = Knit.GetController("SelectionController")
	self.SettlementService = Knit.GetService("SettlementService")

	self.SettlementService.AddWorkerButton:Connect(function(...)
		self:CreateWorkerButton(...)
	end)

	self.SettlementService.AddSettlementBillboard:Connect(function(...)
		self:CreateBillboard(...)
	end)

	self.ScreenGui.Enabled = true
end

return GUIController
]]></string>
        </Properties>
