    <Item class="Folder" referent="18">
      <Properties>
        <string name="Name">Modules</string>
      </Properties>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">SoundPlayer</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Promise = require(ReplicatedStorage.Packages.Promise)
local Sound = {}

function Sound.playSound(sound, parent, random)
	return Promise.new(function(resolve, reject)
		local s = sound:Clone()

		if random then
			s.TimePosition = (math.random() * s.TimeLength) / 5
		end

		if parent:IsA("Model") then
			s.Parent = parent.PrimaryPart
		elseif parent:IsA("Part") then
			s.Parent = parent
        end

		s.Ended:Connect(function()
			s:Destroy()
            resolve()
		end)

        s:Play()
	end)
end

return Sound
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Tiles</string>
          <string name="Source"><![CDATA[local function reverseTable(tab)
	local ntab = {}
	for i, v in pairs(tab) do
		ntab[v.name] = i
	end
	return ntab
end

local Tiles = {}

Tiles.Main = {
	{ name = "Grass", service = "TileService", grow = "Forest", canSettle = true },
	{ name = "Sand", service = "TileService", grow = "PalmSand", canSettle = true },
	{ name = "Desert", service = "TileService", grow = "CactusDesert", raise = "DesertRuins", canSettle = true },
	{ name = "Snow", service = "TileService", grow = "SnowForest", raise = "SnowMountain", canSettle = true },
	{ name = "Stone", service = "TileService", raise = "Mountain", canSettle = true },
	{ name = "Farmland", service = "TileService", grow = "Farm" },
	{ name = "CactusDesert", service = "GrowTileService" },
	{ name = "DesertRuins", service = "RaiseTileService", work = "DesertRuinsClaimed" },
	{ name = "DesertRuinsClaimed", service = "WorkedTileService" },
	{ name = "Farm", service = "GrowTileService", work = "FarmClaimed" },
	{ name = "FarmClaimed", service = "WorkedTileService" },
	{ name = "Forest", service = "GrowTileService", work = "ForestClaimed" },
	{ name = "ForestClaimed", service = "WorkedTileService" },
	{ name = "Mountain", raise = "Volcano", service = "RaiseTileService", work = "MountainClaimed" },
	{ name = "MountainClaimed", service = "WorkedTileService" },
	{ name = "PalmSand", service = "GrowTileService", work = "PalmSandClaimed" },
	{ name = "PalmSandClaimed", service = "WorkedTileService" },
	{ name = "SettlementLV1", service = "SettlementService" },
	{ name = "SettlementLV2", service = "SettlementService" },
	{ name = "SettlementLV3", service = "SettlementService" },
	{ name = "SnowForest", service = "GrowTileService", work = "SnowForestClaimed" },
	{ name = "SnowForestClaimed", service = "WorkedTileService" },
	{ name = "SnowMountain", service = "RaiseTileService", work = "SnowMountainClaimed" },
	{ name = "SnowMountainClaimed", service = "WorkedTileService" },
	{ name = "Volcano", service = "RaiseTileService", work = "VolcanoClaimed" },
	{ name = "VolcanoClaimed", service = "WorkedTileService" },
	{ name = "SettlementLV4", service = "SettlementService" },
	{ name = "SettlementLV5", service = "SettlementService" },
}

setmetatable(Tiles.Main, {
	__index = function(_, key)
		local reversed = Tiles._reversed[key]
		if reversed then
			return Tiles.Main[reversed]
		end
		return nil
	end,
})

Tiles._reversed = reverseTable(Tiles.Main)

function Tiles.checkSettle(name)
	if Tiles.Main[name].canSettle then
		return true
	end

	return false
end

function Tiles.checkWork(tile)
	if not tile then
		return false
	end

	if Tiles.Main[tile.name].work then
		return true
	end

	return false
end

return Tiles
]]></string>
        </Properties>
      </Item>
    </Item>
